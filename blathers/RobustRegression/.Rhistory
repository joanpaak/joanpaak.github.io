setwd("~/Desktop/GITRepositories/joanpaak.github.io/blathers/RobustRegression/")
set.seed(123)
# Create data set
n = 20
x = runif(n, -6, 6)
y = rnorm(n, x)
x[21] = 6
y[21] = -6
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
points(x[21], y[21], bty = "l", pch = 19, col = "red")
# Fit models
lin_mod = rstan::stan_model("res/linreg.stan")
rob_reg = rstan::stan_model("res/robust_reg.stan")
two_comp = rstan::stan_model("res/two_component.stan")
data_wo_outlier = list(
n = 20,
x = x[1:20],
y = y[1:20]
)
data = list(
n = 21,
x = x,
y = y
)
fit_lin_wo_out = rstan::sampling(lin_mod, data = data_wo_outlier)
fit_lin = rstan::sampling(lin_mod, data = data)
fit_rob = rstan::sampling(rob_reg, data = data)
fit_two = rstan::sampling(two_comp, data = data)
coef_lin0 = colMeans(as.matrix(fit_lin_wo_out))
coef_lin1 = colMeans(as.matrix(fit_lin))
# Fig 1:
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
curve(coef_lin0[1] + coef_lin0[2] * x, add = TRUE, col = "red")
# Fig 2:
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
points(x[21], y[21], bty = "l", pch = 19, col = "red")
curve(coef_lin1[1] + coef_lin1[2] * x, add = TRUE, col = "red", lty = 1)
# Fig 3:
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
points(x[21], y[21], bty = "l", pch = 19, col = "red")
curve(coef_lin1[1] + coef_lin1[2] * x, add = TRUE, col = "red", lty = 2)
curve(coef_lin0[1] + coef_lin0[2] * x, add = TRUE, col = "red", lty = 1)
# Fig 4 ennusteet iman outlieria
# Fig 5:
n_rep = 100
samples_lin = as.matrix(fit_lin)[,c("a", "b", "sigma")]
y_rep_lin = matrix(NaN, ncol = 21, nrow = n_rep)
for(i in 1:n_rep){
y_rep_lin[i,] = rnorm(21,
samples_lin[i,1] + samples_lin[i,2] * x,
samples_lin[i,3])
}
matplot(x, t(y_rep_lin), type = "p", col  = rgb(0, 0, 0, 0.1))
points(x, y, bty = "l", pch = 19, col = "red")
# Fig 6:
n_rep = 100
samples_rob = as.matrix(fit_rob)[,c("a", "b", "sigma")]
y_rep_lin = matrix(NaN, ncol = 21, nrow = n_rep)
for(i in 1:n_rep){
y_rep_lin[i,] = samples_lin[i,1] + samples_lin[i,2] * rt(21, samples_rob[i,4])
}
coef_lin_wo_outlier = colMeans(as.matrix(fit_lin_wo_out))
coef_lin = colMeans(as.matrix(fit_lin))
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
curve(coef_lin_wo_outlier[1] +
coef_lin_wo_outlier[2] * x, add = TRUE, col = "red")
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
points(x[21], y[21], bty = "l", pch = 19, col = "red")
curve(coef_lin[1] + coef_lin1[2] * x, add = TRUE, col = "red", lty = 1)
curve(coef_lin[1] + coef_lin[2] * x, add = TRUE, col = "red", lty = 1)
plot(NULL, ylim = range(y), xlim = range(x), bty = "l")
grid()
points(x[1:20], y[1:20], bty = "l", pch = 19)
points(x[21], y[21], bty = "l", pch = 19, col = "red")
curve(coef_lin[1] + coef_lin[2] * x, add = TRUE, col = "red", lty = 2)
curve(coef_lin_wo_outlier[1] +
coef_lin_wo_outlier[2] * x, add = TRUE, col = "red", lty = 1)
n_rep = 100
samples_lin_woo = as.matrix(fit_lin_wo_out)[,c("a", "b", "sigma")]
n_rep = 100
samples_lin_woo = as.matrix(fit_lin_wo_out)[,c("a", "b", "sigma")]
y_rep_lin_woo = matrix(NaN, ncol = 21, nrow = n_rep)
y_rep_lin_woo = matrix(NaN, ncol = 21, nrow = n_rep)
for(i in 1:n_rep){
y_rep_lin_woo[i,] = rnorm(21,
samples_lin_woo[i,1] + samples_lin_woo[i,2] * x,
samples_lin_woo[i,3])
}
matplot(x, t(y_rep_lin_woo), type = "p", col  = rgb(0, 0, 0, 0.1))
points(x, y, bty = "l", pch = 19, col = "red")
# Fig 5:
n_rep = 100
samples_lin = as.matrix(fit_lin)[,c("a", "b", "sigma")]
y_rep_lin = matrix(NaN, ncol = 21, nrow = n_rep)
for(i in 1:n_rep){
y_rep_lin[i,] = rnorm(21,
samples_lin[i,1] + samples_lin[i,2] * x,
samples_lin[i,3])
}
matplot(x, t(y_rep_lin), type = "p", col  = rgb(0, 0, 0, 0.1))
points(x, y, bty = "l", pch = 19, col = "red")
