fit_lin_wo_out = rstan::sampling(lin_mod, data = data_wo_outlier)
fit_lin_wo_out
rstan::extract(fit_lin_wo_out, par=c("y_rep"))
y_rep = rstan::extract(fit_lin_wo_out, par=c("y_rep"))
plot(x[1:20], colMeans(y_rep))
dim(y_rep)
y_rep
plot(x[1:20], colMeans(y_rep$y_rep))
dim(y_rep$y_rep)
